# ==============================================================================
# MailScope – Production Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service (Flask / Gunicorn)
# ------------------------------------------------------------------------------
# Port for the WSGI server (Render, Railway, and Cloud Run inject this automatically)
PORT=5000

# Strict production environment (disables debug mode and trace dumps)
FLASK_ENV=production

# Fully qualified origin URL of the deployed frontend SPA (no trailing slash)
# Multiple origins may be separated by commas (e.g., https://mailscope.com,https://app.mailscope.com)
FRONTEND_ORIGIN=https://mailscope.vercel.app

# Maximum number of email addresses allowed per batch request (default: 100)
MAX_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# Frontend Service (Vite React SPA)
# ------------------------------------------------------------------------------
# Publicly accessible URL pointing to the deployed backend service (no trailing slash)
# This MUST be set at frontend build time as Vite bakes environment variables into the static bundle.
VITE_API_BASE_URL=https://mailscope-api.onrender.com

# ------------------------------------------------------------------------------
# Production Notes & Network Constraints
# ------------------------------------------------------------------------------
# 1. SMTP Outbound Probing:
#    Outbound TCP port 25 is blocked by default on AWS, GCP Cloud Run, Render,
#    and Vercel serverless functions.
#    MailScope is designed with this constraint:
#    - SMTP checks are disabled by default.
#    - When enabled, blocked connections are safely classified as INCONCLUSIVE
#      (reason_code: SMTP_UNAVAILABLE), never falsely classified as bounces.
# 2. No Secrets Committed:
#    MailScope does not require database credentials or third-party secret keys.
#    Do not commit active API keys or private certificates to source control.
