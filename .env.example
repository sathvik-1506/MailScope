# MailScope – Environment Configuration
# Copy this file to .env for local development.

# ------------------------------------------------------------------
# Backend Configuration (Flask)
# ------------------------------------------------------------------

# Port the Flask backend server listens on (default: 5000)
PORT=5000

# Allowed CORS origin for the backend (Frontend dev server: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Flask environment: 'development' or 'production'
FLASK_ENV=development

# Optional maximum batch size per request (default: 100)
MAX_BATCH_SIZE=100

# ------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------

# Base URL pointing to the MailScope backend API
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------
# SMTP Verification Flags
# ------------------------------------------------------------------
# SMTP checks are disabled by default on every request.
# Callers must explicitly opt in via the API request payload {"smtp_enabled": true}.
# Handshake issues RCPT TO only; DATA is never executed.
